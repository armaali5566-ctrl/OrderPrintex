            "mainEntity": [
                {
                    "@type": "Question",
                    "name": "What is the difference between Direct UV printing and UV DTF?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Direct UV printing prints ink straight onto the rigid object placed on our flatbed vacuum table with instant UV LED lamp curing and zero sticker borders. UV DTF prints onto a transfer film for application onto curved objects."
                    }
                },
                {
                    "@type": "Question",
                    "name": "What is the maximum object size and thickness for flatbed UV printing?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Our flatbed machines accommodate sheets and objects up to 600mm x 900mm in area and up to 100mm in thickness."
                    }
                },
                {
                    "@type": "Question",
                    "name": "Is the direct flatbed print scratch-resistant and waterproof?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Yes, UV LED curing creates an instantly cross-linked polymer shell that bonds permanently to acrylic, wood, glass, metal, and leather with specialized primers."
