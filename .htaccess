# ==========================================================
# ORDERPRINTEX — Production Apache Configuration (.htaccess)
# Clean URLs, Security Hardening & Performance Caching
# ==========================================================

Options -Indexes +FollowSymLinks
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Custom 404 Error Document
    ErrorDocument 404 /404.php

    # 1. 301 Canonical Redirect: Ugly product-details.php?slug=xxx -> /product/xxx/
    RewriteCond %{THE_REQUEST} \s/product-details\.php\?slug=([a-zA-Z0-9_-]+)\s [NC]
    RewriteRule ^ /product/%1/? [R=301,L]

    # 2. 301 Redirect: Legacy /products/xxx -> /product/xxx/
    RewriteRule ^products/([a-zA-Z0-9_-]+)/?$ /product/$1/ [R=301,L]

    # 3. Clean Product URL: /product/xxx/ -> product-details.php?slug=xxx
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ product-details.php?slug=$1 [L,QSA]

    # 4. Clean Products Catalog: /products or /products/ -> products.php
    RewriteRule ^products/?$ products.php [L,QSA]

    # 5. Clean Services Subpages: /services/xxx/ -> services/xxx.php
    RewriteCond %{DOCUMENT_ROOT}/services/$1.php -f
    RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ services/$1.php [L,QSA]

    # 6. Clean Services Overview: /services or /services/ -> services.php
    RewriteRule ^services/?$ services.php [L,QSA]

    # 7. Clean Blog Details: /blog/xxx/ -> blog-details.php?slug=xxx
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-details.php?slug=$1 [L,QSA]

    # 8. Clean Blog Listing: /blog or /blog/ -> blog.php
    RewriteRule ^blog/?$ blog.php [L,QSA]

    # 9. Clean About Us: /about or /about/ -> about.php
    RewriteRule ^about/?$ about.php [L,QSA]

    # 10. Clean Contact: /contact or /contact/ -> contact.php
    RewriteRule ^contact/?$ contact.php [L,QSA]

    # 11. Clean Gallery: /gallery or /gallery/ -> gallery.php
    RewriteRule ^gallery/?$ gallery.php [L,QSA]

    # 12. Clean Get Quote: /get-quote or /get-quote/ -> get-quote.php
    RewriteRule ^get-quote/?$ get-quote.php [L,QSA]

    # 13. Clean FAQ: /faq or /faq/ -> faq.php
    RewriteRule ^faq/?$ faq.php [L,QSA]
</IfModule>

# Block access to hidden, database and sensitive files
<FilesMatch "(\.(bak|config|sql|sqlite|db|env|log|ini|sh|git.*)|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block PHP execution in upload folders
<DirectoryMatch "^.*/uploads/.*$">
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>
</DirectoryMatch>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
